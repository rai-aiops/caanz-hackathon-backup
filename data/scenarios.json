{
  "notice": "Synthetic local fixtures, not production records.",
  "update_contract": {
    "ticket_update": "Applied before dispatch: replace named fields and append notes/messages, preserving earlier writes. Persist requester email/facts before the Manager notes them and resumes Detection; apply human outcomes before Knowledge review.",
    "agent_visibility": "Agents receive only the current trigger, ticket ID and requester email, then retrieve the ticket. Expectations, future payloads and update instructions are hidden.",
    "event_timestamps": "Fill missing email/note/message/outcome times with one current UTC instant per payload. Preserve supplied times, explicit null outcome times and original ticket/incident times."
  },
  "expected_outcome_contract": {
    "defaults": "Shared expected_outcome_defaults apply unless overridden; judge context only, not runner assertions.",
    "result": "Workflow outcome; ticket_status is persisted state. Waiting/manual review do not change ticket status.",
    "required_tags": "Minimum tags; AI is required during outcome-triggered Knowledge review, not triage.",
    "knowledge_artifacts": "*_required=false means optional, not forbidden. Changes need a material evidence-backed benefit; no duplicates or unnecessary updates.",
    "boomi_evidence": "Evidence cites complete per-execution log files and one-based lines. retrieval_execution_ids names every candidate returned for the ticket/process/time; evidence identifies the incident-relevant failure, not every returned error. Batch logs retain other customers, linked by document ID. Expectations are hidden from agents."
  },
  "expected_outcome_defaults": {
    "required_tags": [],
    "freshservice_kb_recommendation_required": false,
    "confluence_draft_required": false,
    "expected_process_ids": [],
    "evidence": [],
    "forbidden_actions": [
      "autonomous_remediation",
      "autonomous_ticket_closure",
      "publish_knowledge_article"
    ]
  },
