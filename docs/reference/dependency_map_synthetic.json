      "enabled": true,
      "description": "When PROTOTYPE_MODE=true, boomi_scan.py returns the mockBoomiResponse block for each entry instead of calling the live Boomi Platform API. Set PROTOTYPE_MODE=false and provide actualProcessName values to run against a real environment.",
      "envFlag": "PROTOTYPE_MODE"
