    "body": {
      "format": "structured",
      "sections": [
        {
          "sectionId": "sec-001",
          "heading": "Purpose",
          "content": "This document maps member-facing actions in the MemberPortal to the integration processes they trigger, the downstream systems they affect, and the team responsible for each process. It is the primary reference for the incident triage agent when identifying which integration process to inspect for a reported issue."
        },
        {
          "sectionId": "sec-002",
          "heading": "How to Use This Document",
          "content": "When a ticket arrives describing a member-facing symptom, match the symptom keywords to a Member Action below. Follow the row to identify the candidate integration process, systems involved, and owning team. Use the Process Name to query Boomi logs via the Inspect Boomi Log Tool."
        }
      ]
    },
